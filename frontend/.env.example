# ── Frontend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# In Vercel, add these under Project → Settings → Environment Variables

# Point to your deployed Render backend
REACT_APP_API_BASE_URL=https://transitops-backend.onrender.com/api

# Optional: Sentry React project DSN (error tracking is off without it)
REACT_APP_SENTRY_DSN=
