# Copy to .env for local development. On Render, set these under Environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transitops
DB_USER=postgres
DB_PASSWORD=
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # overrides the DB_* values
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Optional Sentry Node project DSN
SENTRY_DSN=
